# Only apps/web is served (see outputDirectory in vercel.json). Everything else
# is backend, tooling or generated output, and build/ is both enormous and
# partly unreadable, which would fail a CLI deploy.
.git
.venv
build/
out/
docs/
tests/
fixtures/
src/
scripts/
.ai/
**/__pycache__/
*.pyc
*.pyo
.pytest_cache/

# Publish application assets, never local credentials or private reference inputs.
.env
.env.*
**/.env
**/.env.*
.codex/
.agents/
.vercel/
**/.vercel/
ohmni_reference_visual_plan/
OHMNI_REFERENCE_IMPLEMENTATION_PLAN.md
node_modules/
**/node_modules/
apps/web/tests/
