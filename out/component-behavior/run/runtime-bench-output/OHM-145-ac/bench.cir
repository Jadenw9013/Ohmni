OHMNI sourced behavior circuit
.options tnom=25
.temp 25
Iexcitation1 0 n1 DC 0 AC 0.0001
Xc1 n1 0 ohm_xtal L1=0.02665740890744692 C1=1.65e-15 R1=50 C0=5.2000000000000001e-13
* OHMNI BVD crystal subcircuit. Terminals: 1 2. Params: L1 (H), C1 (F), R1 (ohm), C0 (F)
.subckt ohm_xtal 1 2 L1=44m C1=9f R1=80 C0=3p
Lm 1 a {L1}
Cm a b {C1}
Rm b 2 {R1}
C0x 1 2 {C0}
.ends ohm_xtal

.control
set numdgt=15
op
echo OHMNI_AC_OP
print v(n1)
echo OHMNI_AC_POINT 0
ac lin 1 23997626.393828198 23997626.393828198
print real(frequency) real(v(n1)) imag(v(n1))
echo OHMNI_AC_POINT 1
ac lin 1 23997676.393828198 23997676.393828198
print real(frequency) real(v(n1)) imag(v(n1))
echo OHMNI_AC_POINT 2
ac lin 1 23997726.393828198 23997726.393828198
print real(frequency) real(v(n1)) imag(v(n1))
echo OHMNI_AC_POINT 3
ac lin 1 23999950 23999950
print real(frequency) real(v(n1)) imag(v(n1))
echo OHMNI_AC_POINT 4
ac lin 1 24000050 24000050
print real(frequency) real(v(n1)) imag(v(n1))
quit
.endc
.end
