# Optional local demo-server configuration. Never commit real credentials.
# scripts/demo_server.py reads root .env; shell variables win.
# Plain NAME=value only: no quotes, export prefix or variable expansion.
# Other CLI commands do not load this file; .env.local is not loaded.

# Only set for owner-authorized live AI planning (can incur charges).
ANTHROPIC_API_KEY=

# Leave blank for the default configured in the provider code.
OHMNI_ANTHROPIC_MODEL=

# Optional absolute local project-storage directory. Default: out/demo-jobs.
# Give each worktree its own storage; don't share a live SQLite directory.
OHMNI_OUTPUT_DIR=

# KiCad and ngspice executable directories belong on PATH.
# OHMNI_KICAD_CLI / OHMNI_NGSPICE are not supported discovery overrides.
# Telemetry is disabled by default; no Sentry credentials are needed for setup.
