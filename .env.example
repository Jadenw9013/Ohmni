# ProofBoard environment.
#
# Nothing in the current build reads any of these: the deterministic verifier
# has no external dependencies at all. They are here for the phases that follow.
#
# Secrets live in the environment only. Never in a generated KiCad project,
# never in logs (SECURITY.md).

# Model provider, for Phase 4 (LLM-proposed CircuitIR, behind schema validation).
ANTHROPIC_API_KEY=

# Override tool discovery if these are not on PATH or in a standard location.
# `python -m proofboard doctor` reports what was found.
PROOFBOARD_KICAD_CLI=
PROOFBOARD_NGSPICE=
