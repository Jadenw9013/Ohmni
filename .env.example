# Ohmni environment.
#
# The local demo server reads these values without replacing variables already
# set by the shell. The deterministic verifier has no external dependencies.
#
# Secrets live in the environment only. Never in a generated KiCad project,
# never in logs (SECURITY.md).

# Model provider for AI planning, behind schema validation.
ANTHROPIC_API_KEY=

# Optional pinned model override. Leave blank to use Ohmni's reviewed default.
OHMNI_ANTHROPIC_MODEL=

# Override tool discovery if these are not on PATH or in a standard location.
# `python -m ohmni doctor` reports what was found.
OHMNI_KICAD_CLI=
OHMNI_NGSPICE=
