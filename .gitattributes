# The frozen benchmark corpora are content-addressed. Keeping them LF in
# every working tree means a Windows checkout and a Linux CI runner hold
# the same bytes, which is one less way for the freeze to disagree with
# itself. scripts/benchmark_synthesis.py normalizes newlines as well, so
# neither half depends on the other being in place.
tests/fixtures/*.json text eol=lf

# Pinned upstream KiCad footprint files are compared byte for byte against
# the sha256 of the file as its library publishes it, which is LF. A CRLF
# checkout would silently be a different file to that check.
fixtures/footprint_sources/*.kicad_mod text eol=lf

# Visual source manifests hash file bytes, including across Windows checkouts.
apps/web/visual-*.js text eol=lf
apps/web/vendor/*.js text eol=lf
apps/web/vendor/THREE-LICENSE.txt text eol=lf
apps/web/component-library/** text eol=lf

# Supplied modeling specification is provenance input, hashed byte for byte.
PCB_COMPONENT_3D_LIBRARY_SPEC.md -text whitespace=-blank-at-eol

# Linux container entrypoints must remain executable shell text in Windows archives.
scripts/docker-entrypoint.sh text eol=lf

# Preserve the supplied reference archive byte-for-byte: its manifest and
# human approval bind exact hashes. Markdown double-space line breaks are
# intentional in these original plans, so retain them as authored.
ohmni_reference_visual_plan/** -text
OHMNI_REFERENCE_IMPLEMENTATION_PLAN.md -text whitespace=-blank-at-eol
ohmni_reference_visual_plan/*.md whitespace=-blank-at-eol
COMPONENT_SYNTHESIS_PLAN.md whitespace=-blank-at-eol
docs/product/*.md whitespace=-blank-at-eol

# Audit rules, canaries and run evidence are hash-locked as exact bytes.
tools/behavior_audit/RULES.md -text
tools/behavior_audit/rules.yaml -text
tools/behavior_audit/fixtures/*.json -text
out/component-behavior/run/** -text

# Behavior source anchors, model assets and independent review records hash bytes.
COMPONENT_BEHAVIOR_SPEC.md -text
docs/behavior/** -text
src/ohmni/behavior/data/** -text
# The reference-circuit export hashes its generating source file exactly.
scripts/generate_behavior_examples.py -text
# The behavior UI gate hashes this browser script byte for byte.
scripts/verify_behavior_ui.cjs -text
src/ohmni/behavior/reference-circuits.json -text
docs/design/landing-pcb/** -text
.ai/approvals/LANDING-PCB-P1-previous-*.yaml -text whitespace=cr-at-eol
docs/design/landing-pcb/*.md whitespace=-blank-at-eol
apps/web/landing-pcb*.js text eol=lf
apps/web/board-view.js text eol=lf
apps/web/landing-pcb-prototype/*.js text eol=lf
apps/web/landing-pcb-prototype/*.css text eol=lf
apps/web/landing-pcb-prototype/*.html text eol=lf
scripts/prepare_visual_assets.py text eol=lf
scripts/landing_pcb*.cjs text eol=lf
scripts/report_landing_pcb_bindings.mjs text eol=lf
scripts/export_landing_pcb_posters.cjs text eol=lf

# Preserve the owner-supplied circuit proposal as an unverified evidence input.
examples/landing-redesign/supplied-proposal.json -text whitespace=cr-at-eol
examples/landing-redesign/footprints/*.kicad_mod -text whitespace=cr-at-eol
apps/web/landing-pcb-redesign/** text eol=lf
apps/web/landing-pcb-redesign/*.webp -text
tools/landing_redesign/*.py text eol=lf
tests/test_landing_redesign*.py text eol=lf
scripts/landing_redesign_capture.cjs text eol=lf
scripts/export_landing_redesign_posters.cjs text eol=lf
