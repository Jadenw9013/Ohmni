FROM python:3.13-slim
WORKDIR /app
COPY pyproject.toml ./
COPY src/ ./src/
RUN pip install --no-cache-dir ".[fetch]" \
    && useradd --create-home --uid 10001 ohmni \
    && mkdir -p /data && chown ohmni:ohmni /data
ENV PYTHONUNBUFFERED=1 PORT=8080
WORKDIR /data
USER ohmni
EXPOSE 8080
CMD ["python", "-m", "ohmni.integrations.fetch_ai.agent"]
